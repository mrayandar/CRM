// NexoCRM database schema.
//
// Multi-tenancy: every tenant-scoped table carries an `orgId` column.
// The `orgId` value is `Organization.id` (our internal cuid). The
// Organization model links to Clerk via `clerkOrgId`. Every query in
// `lib/data/*.ts` MUST filter by `orgId` — see `.cursor/rules/nexocrm.mdc`.
//
// NOTE: `orgId` on tenant tables is a bare String, not a formal FK to
// Organization.id. This avoids a cross-table migration in this pass. The
// relationship is enforced at the application layer (lib/auth.ts ensures
// a valid Organization exists before any data query runs).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum LeadStatus {
  new
  contacted
  qualified
  unqualified
  lost
}

enum LeadSource {
  Inbound
  Outbound
  Referral
  Event
  Partner
  Website
}

enum Priority {
  low
  medium
  high
}

enum ContactLifecycle {
  Customer
  Champion
  Prospect
  Evaluator
  Churned
}

enum TaskType {
  call
  email
  meeting
  todo
}

enum ActivityKind {
  call
  email
  meeting
  note
  stage
  created
  edited
  task
  won
  lost
  payment
}

enum PaymentStatus {
  pending
  paid
  cancelled
}

/// What a Payment represents within a deal paid in parts. Purely descriptive — nothing in the
/// app branches logic on this besides display and the default assigned by the split action.
enum PaymentLabel {
  Advance
  Milestone
  Final
  Other
}

/**
 * What a Task or Activity is attached to — a lightweight polymorphic reference. `task` is only
 * ever used by Notification (a task itself can be the thing a notification is ABOUT — "this task
 * was assigned to you"); Activity/Task's own `relatedToType`/`subjectType` usage never sets it,
 * since a task's relation to a lead/contact/deal is a different, pre-existing concept from "is
 * this row itself someone's subject."
 */
enum SubjectType {
  lead
  contact
  deal
  task
}

enum PlanTier {
  free
  starter
  pro
  enterprise
}

/// Per-org record visibility for Members. ALL (default, today's only behavior) means every
/// Member sees every record, same as before this existed. OWN restricts a Member to records they
/// own (leads/contacts/deals) or are assigned/created (tasks) — never Admins, who always see
/// everything regardless of this setting. See lib/scope.ts.
enum RepVisibility {
  ALL
  OWN
}

enum ImportEntityType {
  lead
  contact
}

/// task_due and lead_follow_up arrive in Stage C of the reminders/notifications work — only
/// `assigned` is written anywhere yet (Stage B). Keeping all three here now (rather than adding
/// the other two to this enum later) avoids a second enum-altering migration.
enum NotificationKind {
  assigned
  task_due
  lead_follow_up
}

// ---------------------------------------------------------------------------
// Identity & multi-tenancy
// ---------------------------------------------------------------------------

/// Mirrors a Clerk organization. Created via webhook or on-demand on first
/// request. Owns all tenant-scoped data through Organization.id → *.orgId.
model Organization {
  id         String   @id @default(cuid())
  clerkOrgId String   @unique
  name       String
  plan       PlanTier @default(free)

  /// Populated when Stripe billing is wired. Null until then.
  stripeCustomerId String? @unique

  /// Team-wide revenue target for the current quarter, set from Settings -> Workspace. Null
  /// until an admin sets one — the Dashboard shows an honest "set a quota" prompt rather than a
  /// zero-looking comparison when this is null.
  quarterlyQuota Int?

  /// ISO 4217 code (e.g. "USD", "PKR"). Set from Settings -> Workspace, admin-only. Changing it
  /// relabels every amount in the app — it never converts stored values, which stay the same
  /// number regardless of currency (see the confirmation copy in the Settings UI).
  currency String @default("USD")

  /// Real IANA zone id (e.g. "Asia/Karachi"). Used for org-wide business periods — won this
  /// month, quarter-to-date quota, monthly charts, month-over-month, closing in 30 days — but
  /// ONLY once `timezoneConfigured` is true. "UTC" is just the raw DB default for a brand-new
  /// org (no browser context is available at on-demand org-creation time); every org created
  /// before this column existed also reads as "UTC" here, which must never be read as a real,
  /// deliberate choice — see `timezoneConfigured`.
  timezone String @default("UTC")

  /// False until an admin actually saves a workspace time zone in Settings. While false, every
  /// org-wide business-period calculation falls back to the *viewer's own* time zone instead of
  /// trusting `timezone`'s untouched "UTC" default — the same behavior every org had before this
  /// column existed. This is what stops that silent "every pre-existing org now secretly
  /// computes in UTC" regression: without it, there would be no way to tell a deliberate UTC
  /// choice apart from an org that simply hasn't been asked yet.
  timezoneConfigured Boolean @default(false)

  /// Admin-only, changed in Settings with a confirmation (see PROGRESS.md's visibility design).
  /// Stage 1c: updateRepVisibilityAction is the only writer, gated by requireLiveAdminAccess()
  /// (the live Clerk Backend API check, same pattern as requirePaymentWriteAccess — granting
  /// MORE visibility back to every Member, by switching this to ALL, is exactly as sensitive a
  /// change as restricting it, so both directions use the same strict check).
  repVisibility RepVisibility @default(ALL)

  /// Who last changed `repVisibility` (Owner.id) and when — both null until the first change.
  /// Bare string, not a formal relation, same no-cross-table-FK convention as every `orgId`
  /// column in this schema. Shown under the Settings switch.
  repVisibilityChangedBy String?
  repVisibilityChangedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizations")
}

/// A user within a tenant org (e.g. an AE, SDR, Admin). Linked to a Clerk
/// user via `clerkUserId`. When a Clerk user joins an org, an Owner row is
/// created for them in that org. The same Clerk user in two different orgs
/// produces two Owner rows (one per org).
model Owner {
  id          String  @id @default(cuid())
  orgId       String
  clerkUserId String?
  name        String
  email       String
  avatarUrl   String?
  role        String
  /// IANA-ish label the profile form uses (e.g. "Pacific Time (US & Canada)"). Free text, not
  /// validated against a zone database — display preference only, nothing schedules against it.
  timezone    String?

  /// False once this person is removed from the org in Clerk (organizationMembership.deleted).
  /// Soft-delete, not a hard delete: every Lead/Contact/Deal/Task.ownerId and Activity.actorId FK
  /// to Owner is ON DELETE RESTRICT, so a real delete would throw for anyone who ever created a
  /// record or logged an activity — in practice, every real member. Soft-deleting also keeps
  /// historical activity/ownership attribution intact instead of erasing who actually did what.
  active Boolean @default(true)

  /// Last time this owner's time-based notifications (task_due/lead_follow_up) were scanned —
  /// null until their first scan. The scan is claimed atomically by an UPDATE conditioned on this
  /// column (see scanAndNotify in lib/data/notifications.ts), which is what lets two open tabs
  /// polling the unread-count route at the same moment never both scan: whichever UPDATE commits
  /// first changes this value out from under the second one's WHERE clause.
  lastScannedAt DateTime?

  leads           Lead[]
  contacts        Contact[]
  deals           Deal[]
  tasks           Task[]
  tasksCreated    Task[]        @relation("TaskCreatedBy")
  activities      Activity[]
  paymentsCreated Payment[]
  importBatches   ImportBatch[]
  notifications   Notification[]
  notificationPreferences NotificationPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Emails are unique per-org, not globally: two different tenants can
  // legitimately each have an "ava@acme.com".
  @@unique([orgId, email])
  // A Clerk user can exist only once per org.
  @@unique([orgId, clerkUserId])
  @@index([orgId])
  @@map("owners")
}

// ---------------------------------------------------------------------------
// Core CRM models
// ---------------------------------------------------------------------------

/// A real company entity, replacing the plain `company` string that used to live directly on
/// Lead/Contact/Deal. One row per distinct company per org — see the backfill migration for how
/// existing string values were grouped (exact, case-insensitive match within an org; no fuzzy
/// matching across different-looking names).
model Company {
  id       String  @id @default(cuid())
  orgId    String
  name     String
  website  String?
  industry String?
  notes    String?

  leads    Lead[]
  contacts Contact[]
  deals    Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "companies_name_trgm_idx")
  @@map("companies")
}

model Lead {
  id       String     @id @default(cuid())
  orgId    String
  name     String
  title    String
  email    String
  phone    String
  status   LeadStatus @default(new)
  source   LeadSource
  score    Int        @default(0)
  estValue Int        @default(0)
  location String

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  owner   Owner  @relation(fields: [ownerId], references: [id])
  ownerId String

  /// Set when this row came from a CSV import, null otherwise. Lets an admin undo a whole import
  /// (see ImportBatch) and lets the import route detect a retried chunk idempotently (a row whose
  /// client-generated id already exists under THIS batch is a safe no-op retry, not a collision —
  /// see lib/data/import.ts).
  importBatchId String?

  /// A calendar date, not an instant — stored as midnight UTC of the date picked (same convention
  /// Task.dueDate already uses: an HTML date input's "YYYY-MM-DD" parses to UTC midnight via
  /// `new Date(dateString)`). Every comparison against it (the Leads filter, the lead_follow_up
  /// notification) must compare calendar dates in the *recipient's own* timezone, never by raw
  /// instant arithmetic — see lib/timezones.ts's localDayDelta. Null means no follow-up scheduled.
  followUpAt DateTime?

  createdAt     DateTime @default(now())
  lastTouchedAt DateTime @default(now())

  // Populated once this lead has been converted (mirrors `convertedDealId`
  // on the frontend Lead type). A lead converts into at most one deal and
  // one contact.
  convertedDeal    Deal?
  convertedContact Contact?

  tasks      Task[]
  activities Activity[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, ownerId])
  @@index([orgId, followUpAt])
  @@index([orgId, ownerId, followUpAt])
  @@index([orgId, lastTouchedAt])
  @@index([orgId, companyId])
  @@index([orgId, importBatchId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "leads_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "leads_email_trgm_idx")
  @@map("leads")
}

model Contact {
  id    String   @id @default(cuid())
  orgId String
  name  String
  title String
  email String
  phone String
  tags  String[]

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  lifecycle ContactLifecycle @default(Prospect)
  location  String

  owner   Owner  @relation(fields: [ownerId], references: [id])
  ownerId String

  // Present when this contact originated from converting a lead.
  originLead   Lead?   @relation(fields: [originLeadId], references: [id])
  originLeadId String? @unique

  /// See Lead.importBatchId's identical doc comment.
  importBatchId String?

  accountValue Int @default(0)

  createdAt         DateTime @default(now())
  lastInteractionAt DateTime @default(now())

  // A contact can accumulate multiple deals over the life of the account.
  deals      Deal[]
  tasks      Task[]
  activities Activity[]

  @@index([orgId])
  @@index([orgId, ownerId])
  @@index([orgId, lastInteractionAt])
  @@index([orgId, companyId])
  @@index([orgId, importBatchId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "contacts_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "contacts_email_trgm_idx")
  @@map("contacts")
}

model Deal {
  id       String     @id @default(cuid())
  orgId    String
  name     String
  value    Int
  priority Priority   @default(medium)
  source   LeadSource

  company   Company @relation(fields: [companyId], references: [id])
  companyId String

  stage   PipelineStage @relation(fields: [stageId], references: [id])
  stageId String

  probability Int
  closeDate   DateTime

  owner   Owner  @relation(fields: [ownerId], references: [id])
  ownerId String

  contact   Contact? @relation(fields: [contactId], references: [id])
  contactId String?

  // The lead this deal was converted from, if any (one-to-one — a lead
  // converts into at most one deal).
  lead   Lead?   @relation(fields: [leadId], references: [id])
  leadId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks      Task[]
  activities Activity[]
  payments   Payment[]

  @@index([orgId])
  @@index([orgId, stageId])
  @@index([orgId, ownerId])
  @@index([orgId, companyId])
  @@index([orgId, ownerId, closeDate])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "deals_name_trgm_idx")
  @@map("deals")
}

/// A payment tracked against a Deal (treated as the "project" — there is no separate Project
/// entity). Deliberately a flat list with no PaymentPlan/installment-schedule model: each row is
/// one expected or received amount. Payments never change automatically when the parent Deal
/// changes (e.g. its value is edited) — they're purely informational against whatever the deal's
/// value is *at the time they're viewed*; the UI flags when total received exceeds that value
/// rather than reconciling anything. Admin-only feature for now — see requirePaymentAccess /
/// requirePaymentWriteAccess in lib/auth.ts, which gate every read and write of this model.
model Payment {
  id      String        @id @default(cuid())
  orgId   String
  amount  Int
  status  PaymentStatus @default(pending)
  label   PaymentLabel  @default(Other)
  /// Null means "awaiting milestone" — an installment tied to work completing rather than a
  /// calendar date (e.g. "on delivery"). Never counts as overdue, and gets its own bucket in the
  /// Payments screen. Set later through the normal edit flow once the milestone date is known.
  dueDate DateTime?
  /// Set only when status transitions to `paid`. Deliberately NOT cleared if later cancelled (see
  /// cancelPayment in lib/data/payments.ts) — a payment that was paid and then cancelled must stay
  /// permanently undeletable and keep reading as "paid on X, then cancelled". Received-total math
  /// (receivedTotal in src/lib/utils.ts) excludes it by `status`, never by this field.
  paidAt  DateTime?
  note    String?

  deal   Deal   @relation(fields: [dealId], references: [id])
  dealId String

  createdBy   Owner  @relation(fields: [createdById], references: [id])
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, dealId])
  @@index([orgId, status])
  @@map("payments")
}

/// A pipeline stage a deal can sit in. Per-org, renameable and reorderable via Settings →
/// Pipeline ("Customize stages"). Every org gets 6 default rows (Discovery, Proposal,
/// Negotiation, Contract Sent, Won, Lost) seeded on creation — see `ensureDefaultStages` in
/// lib/data/stages.ts — replacing what used to be the fixed `DealStage` enum.
model PipelineStage {
  id    String @id @default(cuid())
  orgId String

  /// Stable slug, distinct from the user-facing `label`. Only meaningful for the seeded
  /// defaults (lets migrations/seeding identify "the" Won/Lost row); not shown in the UI and
  /// not re-derived when the stage is renamed.
  key   String
  label String

  /// Position among this org's stages; drives kanban column order. Won/Lost stay pinned after
  /// every open stage — see reorderStages in lib/data/stages.ts.
  order Int

  /// Weighted-forecast probability (0-100) associated with this stage.
  probability Int

  /// True for a stage a deal can no longer move on from (Won or Lost).
  isClosed Boolean @default(false)
  /// Only meaningful when isClosed is true — distinguishes Won from Lost.
  isWon    Boolean @default(false)

  deals Deal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, key])
  @@index([orgId])
  @@index([orgId, order])
  @@map("pipeline_stages")
}

model Task {
  id          String   @id @default(cuid())
  orgId       String
  title       String
  /// Optional longer note; added alongside task editing — nothing else used this column before.
  description String?
  dueDate     DateTime
  done        Boolean  @default(false)
  priority    Priority @default(medium)
  type        TaskType @default(todo)

  owner   Owner  @relation(fields: [ownerId], references: [id])
  ownerId String

  /// Who created this task — distinct from `owner` (the assignee), which can be reassigned.
  /// Nullable for now: backfilled for existing rows (to `ownerId`, the closest available
  /// approximation — see the migration), but not yet populated on new rows by any code path, so
  /// a real NOT NULL constraint would break task creation before that write path is updated. Will
  /// be required once OWN-mode visibility actually uses it ("assigned to them or created by
  /// them" — see lib/scope.ts).
  createdBy   Owner?  @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdById String?

  // Polymorphic "related to" reference (lead | contact | deal), denormalized
  // with a label so list views don't need a join to render (mirrors the
  // frontend's `Task.relatedTo` shape).
  relatedToType  SubjectType?
  relatedToLabel String?

  lead      Lead?    @relation(fields: [leadId], references: [id])
  leadId    String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  contactId String?
  deal      Deal?    @relation(fields: [dealId], references: [id])
  dealId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([orgId, ownerId])
  @@index([orgId, createdById])
  @@index([orgId, done, dueDate])
  @@index([orgId, ownerId, done])
  /// For the Calendar screen's listTasksForCalendar (lib/data/tasks.ts) — a dueDate RANGE with no
  /// equality constraint on `done`/`ownerId` at all. EXPLAIN ANALYZE against 5000 generated tasks
  /// showed the existing [orgId, done, dueDate]/[orgId, ownerId, done] indexes could only be used
  /// for their `orgId` prefix here (a B-tree can't skip over an unconstrained `done`/`ownerId` to
  /// reach a range condition on the column after it), so Postgres fell back to filtering every
  /// row in the org by dueDate/ownerId-or-createdById after the orgId-only index scan — linear in
  /// total org task count, not in the requested date range. This index lets dueDate's range
  /// itself be the index condition.
  @@index([orgId, dueDate])
  @@map("tasks")
}

model Activity {
  id    String       @id @default(cuid())
  orgId String
  kind  ActivityKind
  title String
  body  String?
  at    DateTime     @default(now())

  actor   Owner  @relation(fields: [actorId], references: [id])
  actorId String

  /// Denormalized at write time from the subject's current `ownerId` (or `actorId` for a
  /// standalone activity with no subject) — a cache of "who this activity currently belongs to
  /// for OWN-mode visibility," not a stable FK (deliberately a plain scalar, not a relation: a
  /// reassignment cascades this column with a bulk UPDATE, which a relation would complicate).
  /// Nullable for now: backfilled for existing rows (see the migration), but not yet populated on
  /// new rows by any code path — see Task.createdById's identical note.
  ownerId String?

  // Polymorphic "subject" reference (lead | contact | deal), denormalized
  // with a label (mirrors the frontend's `Activity.subject` shape).
  subjectType  SubjectType?
  subjectLabel String?

  lead      Lead?    @relation(fields: [leadId], references: [id])
  leadId    String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  contactId String?
  deal      Deal?    @relation(fields: [dealId], references: [id])
  dealId    String?

  @@index([orgId])
  @@index([orgId, at])
  @@index([orgId, ownerId, at])
  @@index([leadId])
  @@index([contactId])
  @@index([dealId])
  @@map("activities")
}

/// One row per CSV import run (see lib/data/import.ts). Created up front, before any chunk is
/// processed — every chunk of that import re-verifies against this row that it belongs to the
/// same org and the same importer, and is still open (`committedAt == null`), before writing
/// anything. `undoneAt`/`undoneById` record an admin's undo (within the 24h window enforced in
/// code, not in the schema) — a batch is never deleted, so its history (including a failed or
/// partially-undone import) stays visible.
model ImportBatch {
  id         String           @id @default(cuid())
  orgId      String
  entityType ImportEntityType
  totalRows  Int

  importedBy   Owner  @relation(fields: [importedById], references: [id])
  importedById String

  createdCount Int @default(0)
  updatedCount Int @default(0)
  skippedCount Int @default(0)
  failedCount  Int @default(0)

  /// Null while chunks are still being accepted. Set the moment the last expected row has been
  /// processed (or the client explicitly signals the final chunk) — no further chunk is accepted
  /// against this batch once set.
  committedAt DateTime?

  undoneAt   DateTime?
  undoneById String?

  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([orgId, createdAt])
  @@map("import_batches")
}

/// An in-app notification for one recipient. Deliberately stores no record name, value, or
/// amount — a title is always built at READ TIME, either from the subject (via the same scoped
/// by-id reads every other feature uses, so a notification about a record the recipient can no
/// longer see/own just isn't returned) or, for a coalesced notification, from `count` alone.
///
/// subjectType/subjectId are a soft reference (no FK, same convention as Activity's identical
/// pair) — deliberately not a hard relation, so a notification survives the subject being
/// reassigned away or deleted; the read path is what decides whether it's still valid to show
/// (see lib/data/notifications.ts). Both are null for a coalesced notification (a bulk reassign
/// or an import summary), which has no single subject — `count` is set instead, and the title is
/// built directly from `kind` + `count`, never touching a subject lookup at all.
model Notification {
  id          String           @id @default(cuid())
  orgId       String
  kind        NotificationKind

  recipient   Owner  @relation(fields: [recipientId], references: [id])
  recipientId String

  subjectType SubjectType?
  subjectId   String?

  /// Only set for a coalesced notification ("12 leads assigned to you"); null for a normal
  /// single-subject one.
  count Int?

  /// Uniqueness guard, scoped to (orgId, recipientId) — NOT a general dedupe across time. An
  /// `assigned` notification uses the triggering mutation's own activityId (always fresh), so
  /// repeated assignment events (A to B to A) each get their own row, never deduped against each
  /// other. A coalesced import summary uses the ImportBatch's own id instead, so re-running the
  /// same batch-finalization step twice (a retry) can never double-write the same summary — see
  /// each write site in lib/actions/*.ts for which key it uses and why.
  dedupeKey String

  /// The exact calendar-date string ("YYYY-MM-DD", in UTC — the same convention
  /// Task.dueDate/Lead.followUpAt already store their date in) that triggered a task_due or
  /// lead_follow_up notification. Read-time visibility compares this against the subject's
  /// CURRENT dueDate/followUpAt: a mismatch means the date moved since this notification was
  /// written (postponed task, rescheduled follow-up), so the notification is stale and hidden —
  /// see buildNotificationView in lib/data/notifications.ts. Null for 'assigned' (no date
  /// involved) and for a coalesced summary row (no single subject to compare against).
  triggerDate String?

  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@unique([orgId, recipientId, dedupeKey])
  @@index([orgId, recipientId, readAt])
  @@map("notifications")
}

/// One row per (owner, kind) that owner has ever EXPLICITLY changed from the default — absence of
/// a row means "enabled", not "unset", so every owner starts opted in to every kind without a
/// backfill migration having to create rows for them (see isNotificationEnabled in
/// lib/data/notifications.ts). A disabled kind is enforced at both ends: no new notification of
/// that kind is written (checked in every write-function and before scanAndNotify even queries
/// for it) and any existing one of that kind is hidden at read time (listNotifications/
/// getUnreadCount) — so turning a kind off also clears it from the bell, not just future ones.
model NotificationPreference {
  id      String  @id @default(cuid())
  orgId   String
  owner   Owner   @relation(fields: [ownerId], references: [id])
  ownerId String
  kind    NotificationKind
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, ownerId, kind])
  @@index([orgId, ownerId])
  @@map("notification_preferences")
}
