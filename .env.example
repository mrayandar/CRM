# ---------------------------------------------------------------------------
# Database (Prisma + PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/nexocrm?schema=public"

# ---------------------------------------------------------------------------
# Clerk (authentication) — https://dashboard.clerk.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="<your-clerk-publishable-key>"
CLERK_SECRET_KEY="<your-clerk-secret-key>"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# Clerk webhook verification (set in Clerk dashboard → Webhooks → Signing Secret)
CLERK_WEBHOOK_SECRET="<your-clerk-webhook-signing-secret>"

# ---------------------------------------------------------------------------
# Stripe (billing) — https://dashboard.stripe.com/apikeys
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="<your-stripe-secret-key>"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="<your-stripe-publishable-key>"
STRIPE_WEBHOOK_SECRET="<your-stripe-webhook-secret>"

# ---------------------------------------------------------------------------
# AI assist — DEVELOPMENT ONLY. AI_ALLOW_DEV_PROVIDERS must NEVER be set in Vercel/production —
# see PROGRESS.md's pre-launch checklist. The real customer-facing provider (Stage 3) uses its
# own separate env vars, not these.
# ---------------------------------------------------------------------------
# Must be exactly "true" (and only ever in a local .env) for lib/ai/providers/
# openAiCompatibleProvider.ts to run at all — without it, the fake provider is used instead.
AI_ALLOW_DEV_PROVIDERS="true"
# Any OpenAI-compatible chat-completions base URL — e.g. Google AI Studio's Gemini via its
# OpenAI-compatible endpoint: https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL="<your-openai-compatible-base-url>"
AI_API_KEY="<your-dev-provider-api-key>"
# A model id your provider actually serves right now — run `node scripts/ai-try.js --list-models`
# to see current options; model ids get deprecated, so don't assume one from an old example here.
AI_MODEL="<a-current-model-id-from---list-models>"
# Optional — only sent to the provider when set (most providers don't support this field at all).
AI_REASONING_EFFORT=""

# ---------------------------------------------------------------------------
# AI assist — Stage 2 backend. Applies in every environment, including production.
# ---------------------------------------------------------------------------
# Comma-separated Organization.id list (our own cuid, not a Clerk org id) — an org not on this
# list can never turn AI assist on, regardless of admin role. Empty/unset means no org is
# allowlisted. See lib/ai/allowlist.ts.
AI_ASSIST_ALLOWED_ORG_IDS=""
# Set to exactly "true" to block every AI-assist request immediately, without a DB round-trip —
# for when the database itself is what's misbehaving. The DB kill flag (scripts/ai-kill.js) is
# the normal way to kill AI assist without a deploy; this env var is the fallback. See
# lib/ai/killSwitch.ts.
AI_ASSIST_KILL_SWITCH="false"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
